{
    "name": "Light OS",
    "image": "light-os-dev",
    "initializeCommand": "docker buildx build --platform linux/amd64 --provenance=false --load -t light-os-dev -f ${localWorkspaceFolder}/.devcontainer/Dockerfile ${localWorkspaceFolder}",
    "forwardPorts": [ 1234 ],
    "runArgs": ["--platform=linux/amd64"],
    "workspaceFolder": "/workspace",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "customizations": {
        "vscode": {
            "settings": {
                "C_Cpp.intelliSenseEngine": "disabled",
                "clangd.arguments": [
                    "--background-index",
                    "--clang-tidy",
                    "--completion-style=detailed"
                ],
                "files.associations": {
                    "*.h": "c"
                }
            },
            "extensions": [
                "llvm-vs-code-extensions.vscode-clangd",
                "ms-vscode.cpptools"
            ]
        }
    }
}